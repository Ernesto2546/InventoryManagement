@model InventoryManagement.Models.Product

@{
    ViewData["Title"] = "Details";
}

<div class="page-header">
    <h1 class="page-title">
        <i class="bi bi-archive-fill"></i>
        Product Details
    </h1>
</div>

<div class="form-card">
    <div class="card-custom mb-4">
        <h4>Product</h4>
        <hr />

        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Name)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Name)
            </dd>

            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Description)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Description)
            </dd>

            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Price)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Price)
            </dd>

            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Stock)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Stock)
            </dd>

            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.MinimumStock)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.MinimumStock)
            </dd>

            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.CreatedDate)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.CreatedDate)
            </dd>

            <dt class="col-sm-2">Category</dt>
            <dd class="col-sm-10">
                @Model.Category?.Name
            </dd>

            <dt class="col-sm-2">Supplier</dt>
            <dd class="col-sm-10">
                @Model.Supplier?.Name
            </dd>

            <dt class="col-sm-2">
                Category
            </dt>
            <dd class="col-sm-10">
                @Model.Category?.Name
            </dd>

            <dt class="col-sm-2">
                Supplier
            </dt>
            <dd class="col-sm-10">
                @Model.Supplier?.Name
            </dd>
        </dl>
        <div class="d-flex gap-2 mt-3">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil-square me-1"></i> Edit
            </a>

            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                <i class="bi bi-trash me-1"></i> Delete
            </a>

            <a asp-action="Index" class="btn btn-outline-secondary ms-auto">
                <i class="bi bi-list-ul me-1"></i> Back to list
            </a>
        </div>
    </div>
</div>
