@using Microsoft.AspNetCore.Mvc.Rendering
@model InventoryManagement.Models.Product

@{
    ViewData["Title"] = "Edit";
}

<div class="container py-4">
    <div class="page-header">
        <h1 class="page-title">
            <i class="bi bi-pencil-square me-2"></i>
            Edit Product
        </h1>
    </div>
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            <form asp-action="Edit" class="form-card">

                <div class="card-custom mb-4">
                    <h4 class="mb-1">
                        Product Information
                    </h4>

                    <p class="text-muted mb-4">
                        Update the Product information below.
                    </p>

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="row g-4">

                        <div class="col-md-6">
                            <label asp-for="Name" class="control-label"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Description" class="control-label"></label>
                            <input asp-for="Description" class="form-control" />
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Price" class="control-label"></label>
                            <input asp-for="Price" class="form-control" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Stock" class="control-label"></label>
                            <input asp-for="Stock" class="form-control" />
                            <span asp-validation-for="Stock" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MinimumStock" class="control-label"></label>
                            <input asp-for="MinimumStock" class="form-control" />
                            <span asp-validation-for="MinimumStock" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CreatedDate" class="control-label"></label>
                            <input asp-for="CreatedDate" class="form-control" />
                            <span asp-validation-for="CreatedDate" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="control-label"></label>
                            <select asp-for="CategoryId" class="form-select" asp-items="@(ViewBag.CategoryList as SelectList)">
                                <option value="">-- Select category --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SupplierId" class="control-label"></label>
                            <select asp-for="SupplierId" class="form-select" asp-items="@(ViewBag.SupplierList as SelectList)">
                                <option value="">-- Select supplier --</option>
                            </select>
                            <span asp-validation-for="SupplierId" class="text-danger"></span>
                        </div>
                    </div>

                </div>
            
                @{
                    ViewData["SubmitText"] = "Save Changes";
                    ViewData["CancelAction"] = "Index";
                }

                @await Html.PartialAsync("_FormButtons")
            </form>
        </div>
    </div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
